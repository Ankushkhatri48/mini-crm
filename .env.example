# Database
#DATABASE_URL=mysql+pymysql://root:Hello1234@localhost:3306/mini_crm
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/defaultdb
# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Auth users (comma-separated, format: username:plaintext_password:role)
# Roles: admin or viewer
# admin can add/edit/delete/launch campaigns and see audit log
# viewer can only view data and use AI tools
AUTH_PLAIN_USERS=admin:changeme123:admin,viewer:viewonly456:viewer